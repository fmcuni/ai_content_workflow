{
	// Workers-native PoC for the Bowtie AI Content Tool backend.
	//
	// Proves the two hard unknowns of a Workers re-platform on the FREE plan:
	//   1. Postgres (Supabase) from a Worker via `pg` over TCP sockets (nodejs_compat)
	//   2. Long-running, multi-step LLM work as a Cloudflare Workflow, streaming
	//      progress to the browser via a Durable Object (SSE)
	//
	// No containers, no paid plan. The DB stays on Supabase.
	//
	// ACCOUNT: both environments below currently live on Franco's personal
	// Cloudflare account ("Bowtie Content SEO" in the dashboard, subdomain
	// franco-ma.workers.dev). The account previously used for prod (fmc.workers.dev,
	// referenced by CI as CLOUDFLARE_ACCOUNT_ID) has been deprecated by Franco
	// (2026-07-07) — this file no longer has an `alt`/`alt-dev` split because
	// there is only one real account now. Migrating prod out to the company-owned
	// Bowtie Enterprise Account is tracked as a separate follow-up (see
	// docs/secrets-and-ci.md); dev stays on this account for now.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ai-content-workflow-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-30",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"workflows": [
		{
			"name": "production",
			"binding": "PRODUCTION",
			"class_name": "ProductionWorkflow"
		},
		{
			"name": "topic-expansion",
			"binding": "TOPIC_EXPANSION",
			"class_name": "TopicExpansionWorkflow"
		},
		{
			"name": "refresh-scan",
			"binding": "REFRESH_SCAN",
			"class_name": "RefreshScanWorkflow"
		}
	],
	// Cron Trigger — periodic refresh scan (CMS Stage 0). Daily 02:00 UTC.
	// The scheduled() handler in src/index.ts kicks the REFRESH_SCAN Workflow.
	// Exactly ONE deployment may run this against the prod DB; since the fmc
	// account sunset (2026-07-07) that is this Worker.
	"triggers": {
		"crons": [
			"0 2 * * *"
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "RUN_STREAM",
				"class_name": "RunStream"
			},
			// US-pinned proxy DO — DoGeminiClient forwards Gemini calls here so they
			// egress from a US region (Google AI Studio geo-blocks the Asia/HK colo).
			{
				"name": "GEMINI_PROXY",
				"class_name": "GeminiProxy"
			},
			// Per-run Yjs collab-sync DO — backs realtime collaborative editing.
			{
				"name": "RUN_DOC",
				"class_name": "RunDoc"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RunStream"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"GeminiProbe"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"GeminiProxy"
			]
		},
		// Phase 9 cutover — drop the test-only GeminiProbe DO (append-only).
		{
			"tag": "v4",
			"deleted_classes": [
				"GeminiProbe"
			]
		},
		// Realtime-collab Phase 1A — add the per-run RunDoc collab-sync DO.
		{
			"tag": "v5",
			"new_sqlite_classes": [
				"RunDoc"
			]
		}
	],
	// Non-secret. Secrets set via `wrangler secret put`:
	//   POSTGRES_URL, GEMINI_API_KEY, AUTH_SECRET.
	"vars": {
		"GEMINI_MODEL": "gemini-3.1-pro-preview",
		// SSE CORS allow-origin: the deployed frontend Worker (browser-direct SSE to
		// /runs/:id/events and /topic-batches/:id/events). REST goes via Next rewrites
		// (server-side, no CORS). See src/http/cors.ts.
		"FRONTEND_ORIGIN": "https://content.seo.bowtie.hk",
		// Verbose per-step event log: persist raw *.thinking events too. Default
		// ON; set "0"/"false"/"off" to stream thinking live but skip persisting it
		// to content_tool.run_event_logs. Read by the RunStream DO.
		"PERSIST_THINKING": "on",
		// Supabase project URL — public (also baked into the web bundle). Required
		// for JWKS verification of the GoTrue access token (src/auth/jwt.ts); it is
		// authoritative (there is no HS256 fallback once it is set). Secrets
		// SUPABASE_SERVICE_ROLE_KEY (admin user-mgmt) + optional SUPABASE_JWT_SECRET
		// are set via `wrangler secret put`.
		"SUPABASE_URL": "https://gfpkqsiyeslscgsuehmj.supabase.co"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "fa5e038691164995acb76d50153d9d38"
		}
	],
	// Rate Limiting bindings (Cloudflare native `ratelimit`). Abuse-prevention
	// throttles, NOT product quotas — generous caps. Keyed in src/index.ts by
	// authenticated user id (else client IP), per-user AND per-IP. `period` MUST
	// be 10 or 60 (Cloudflare constraint); we use 60 and surface it as the 429
	// `Retry-After`. namespace_id is a unique string-integer per binding; dev
	// (env.dev below) uses a DISTINCT id so dev/prod counters never share state.
	"ratelimits": [
		{
			// Run create/resume(publish)/apply-edits + topic-batch creation.
			"name": "RATE_LIMITER_MUTATION",
			"namespace_id": "2001",
			"simple": {
				"limit": 30,
				"period": 60
			}
		}
	],
	// ─────────────────────────────────────────────────────────────────────────
	// Dev environment — a parallel, fully isolated copy of this backend Worker,
	// deployed as `bowtie-content-tool-poc-dev` via `wrangler deploy --env dev`
	// (or `npm run deploy:dev`). It mirrors prod's bindings but points at a
	// SEPARATE dev Supabase DB + Hyperdrive, and gets its OWN Durable Object
	// namespaces + Workflows (names suffixed `-dev`) so dev run/collab/stream
	// state never collides with prod. Same Cloudflare account as prod (above).
	//
	// Non-inheritable keys (vars, durable_objects, workflows, hyperdrive) MUST be
	// repeated here — they are NOT inherited from the top level. `migrations`
	// (top-level only) and `compatibility_*` / `main` / `observability` ARE
	// inherited, so they are intentionally omitted.
	"env": {
		"dev": {
			"name": "bowtie-content-tool-poc-dev",
			// Disable the daily refresh-scan cron in dev. `crons: []` disables it;
			// omitting the key would INHERIT the top-level "0 2 * * *" and run scans
			// (Gemini spend + writes) against the dev DB on a schedule.
			"triggers": {
				"crons": []
			},
			// Distinct workflow `name`s (binding + class_name unchanged so the code
			// in src/ is identical) to avoid any cross-Worker name ownership clash
			// with the prod Worker's workflows.
			"workflows": [
				{
					"name": "production-dev",
					"binding": "PRODUCTION",
					"class_name": "ProductionWorkflow"
				},
				{
					"name": "topic-expansion-dev",
					"binding": "TOPIC_EXPANSION",
					"class_name": "TopicExpansionWorkflow"
				},
				{
					"name": "refresh-scan-dev",
					"binding": "REFRESH_SCAN",
					"class_name": "RefreshScanWorkflow"
				}
			],
			// Same DO classes; the dev Worker gets its own isolated DO namespaces.
			// Top-level `migrations` (v1..v5) apply to this Worker on first deploy.
			"durable_objects": {
				"bindings": [
					{
						"name": "RUN_STREAM",
						"class_name": "RunStream"
					},
					{
						"name": "GEMINI_PROXY",
						"class_name": "GeminiProxy"
					},
					{
						"name": "RUN_DOC",
						"class_name": "RunDoc"
					}
				]
			},
			"vars": {
				"GEMINI_MODEL": "gemini-3.1-pro-preview",
				// Browser-direct SSE allow-origin: the DEV frontend Worker.
				"FRONTEND_ORIGIN": "https://bowtie-content-tool-web-dev.franco-ma.workers.dev",
				"PERSIST_THINKING": "on",
				// Dev Supabase project (JWKS issuer for the dev GoTrue tokens). Must
				// match NEXT_PUBLIC_SUPABASE_URL baked into the dev web build, or
				// every dev request 401s.
				"SUPABASE_URL": "https://ovxvhxwmqeccjudhyfbh.supabase.co"
			},
			// Dev Hyperdrive config, pointing at the dev Supabase DB.
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "230e538bb55d4385bca5ec9f9f3e2cc1"
				}
			],
			// Rate Limiting (non-inheritable — repeated for dev). DISTINCT
			// namespace_id from prod so dev abuse counters never share state with
			// prod. Same generous caps + 60s period.
			"ratelimits": [
				{
					"name": "RATE_LIMITER_MUTATION",
					"namespace_id": "3001",
					"simple": {
						"limit": 30,
						"period": 60
					}
				}
			]
		}
	}
}
