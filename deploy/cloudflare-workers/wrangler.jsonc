{
	// Workers-native PoC for the Bowtie AI Content Tool backend.
	//
	// Proves the two hard unknowns of a Workers re-platform on the FREE plan:
	//   1. Postgres (Supabase) from a Worker via `pg` over TCP sockets (nodejs_compat)
	//   2. Long-running, multi-step LLM work as a Cloudflare Workflow, streaming
	//      progress to the browser via a Durable Object (SSE)
	//
	// No containers, no paid plan. The DB stays on Supabase.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bowtie-content-tool-poc",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-30",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"workflows": [
		{
			"name": "production",
			"binding": "PRODUCTION",
			"class_name": "ProductionWorkflow"
		},
		{
			"name": "topic-expansion",
			"binding": "TOPIC_EXPANSION",
			"class_name": "TopicExpansionWorkflow"
		},
		{
			"name": "refresh-scan",
			"binding": "REFRESH_SCAN",
			"class_name": "RefreshScanWorkflow"
		}
	],
	// Cron Trigger (free plan) — periodic refresh scan (CMS Stage 0). Daily 02:00 UTC.
	// The scheduled() handler in src/index.ts kicks the REFRESH_SCAN Workflow.
	"triggers": {
		"crons": [
			"0 2 * * *"
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "RUN_STREAM",
				"class_name": "RunStream"
			},
			// US-pinned proxy DO — DoGeminiClient forwards Gemini calls here so they
			// egress from a US region (Google AI Studio geo-blocks the Asia/HK colo).
			{
				"name": "GEMINI_PROXY",
				"class_name": "GeminiProxy"
			},
			// Per-run Yjs collab-sync DO — backs realtime collaborative editing.
			{
				"name": "RUN_DOC",
				"class_name": "RunDoc"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RunStream"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"GeminiProbe"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"GeminiProxy"
			]
		},
		// Phase 9 cutover — drop the test-only GeminiProbe DO (append-only).
		{
			"tag": "v4",
			"deleted_classes": [
				"GeminiProbe"
			]
		},
		// Realtime-collab Phase 1A — add the per-run RunDoc collab-sync DO.
		{
			"tag": "v5",
			"new_sqlite_classes": [
				"RunDoc"
			]
		}
	],
	// Non-secret. Secrets set via `wrangler secret put`:
	//   POSTGRES_URL, GEMINI_API_KEY, AUTH_SECRET, RESEND_API_KEY.
	"vars": {
		"GEMINI_MODEL": "gemini-3.1-pro-preview",
		// SSE CORS allow-origin: the deployed frontend Worker (browser-direct SSE to
		// /runs/:id/events and /topic-batches/:id/events). REST goes via Next rewrites
		// (server-side, no CORS). Also better-auth baseURL/trustedOrigins. See
		// src/http/cors.ts and src/auth/auth.ts.
		"FRONTEND_ORIGIN": "https://bowtie-content-tool-web.fmc.workers.dev",
		// Auth (better-auth). From header for Resend verification/reset email.
		// TEST PHASE: Resend's no-DNS sender (delivers only to the Resend account
		// owner's own email). Switch to "noreply@bowtie.com.hk" once that domain is
		// DNS-verified in Resend.
		"RESEND_FROM": "Bowtie Content Desk <onboarding@resend.dev>",
		// Email-domain allowlist for self-serve sign-up. Comma-separated to add more
		// (e.g. "bowtie.com.hk,bowtie.com.sg") without a code deploy.
		"ALLOWED_EMAIL_DOMAINS": "bowtie.com.hk",
		// TEMPORARY: verification disabled while Resend sending is sorted out (the
		// test sender can't reliably deliver). Remove this line (or set to "on")
		// and redeploy once bowtie.com.hk is DNS-verified in Resend.
		"EMAIL_VERIFICATION": "off",
		// Verbose per-step event log: persist raw *.thinking events too. Default
		// ON; set "0"/"false"/"off" to stream thinking live but skip persisting it
		// to content_tool.run_event_logs. Read by the RunStream DO.
		"PERSIST_THINKING": "on",
		// Auth provider selector. MUST be pinned here (non-secret) so it is
		// deterministic across deploys — a `wrangler deploy` rewrites the var set,
		// so an out-of-band dashboard value would be wiped, silently reverting the
		// backend to better-auth and 401-ing every Supabase Bearer token.
		"AUTH_PROVIDER": "supabase",
		// Supabase project URL — public (also baked into the web bundle). Required
		// for JWKS verification of the GoTrue access token (src/auth/jwt.ts). With
		// AUTH_PROVIDER=supabase this is authoritative; there is no HS256 fallback.
		// Secrets SUPABASE_SERVICE_ROLE_KEY (admin user-mgmt) + optional
		// SUPABASE_JWT_SECRET are set via `wrangler secret put`.
		"SUPABASE_URL": "https://gfpkqsiyeslscgsuehmj.supabase.co"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "58b74deb12184195a83526e6b7040a32"
		}
	]
}