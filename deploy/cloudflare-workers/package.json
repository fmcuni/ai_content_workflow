{
  "name": "bowtie-content-tool-poc",
  "private": true,
  "type": "module",
  "description": "Workers-native PoC: DB-over-sockets + Workflow(Gemini) + Durable Object SSE",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env dev",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "typecheck:workers": "tsc --noEmit -p tsconfig.workers-test.json",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts"
  },
  "overrides": {
    "esbuild": ">=0.28.1"
  },
  "dependencies": {
    "@google/genai": "^2.7.0",
    "@types/markdown-it": "^14.1.2",
    "hono": "^4.12.23",
    "jose": "^6.2.3",
    "langfuse": "^3.38.20",
    "lib0": "^0.2.117",
    "markdown-it": "^14.2.0",
    "node-html-markdown": "^2.0.0",
    "postgres": "^3.4.9",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.13",
    "@cloudflare/workers-types": "^4.20260530.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7",
    "wrangler": "^4.95.0"
  }
}
