{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bowtie Content Tool",
  "version": "0.5.6",
  "identifier": "sg.com.bowtie.contenttool",
  "build": {
    "frontendDist": "frontend-dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bowtie Content Tool",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/content-tool-api"],
    "resources": ["resources/frontend"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {}
}
