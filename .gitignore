# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
htmlcov/
.coverage
.coverage.*
dist/
build/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
.turbo/
.pnpm-store/
*.tsbuildinfo

# Environment & secrets
.env
.env.local
.env.*.local
*.key
*.pem

# Desktop app local config (normally lives outside the repo under
# ~/Library/Application Support/BowtieContentTool; guarded here in case
# BOWTIE_CONFIG_DIR is pointed inside the repo)
BowtieContentTool/

# Desktop packaging artifacts (also covered by src-tauri/.gitignore and build/)
src-tauri/target/
src-tauri/binaries/
src-tauri/resources/
src-tauri/gen/
src-tauri/icons/*.png
src-tauri/icons/*.icns
src-tauri/icons/*.ico

# IDE
.vscode/
.idea/
.claude/
.playwright-cli/
.playwright-mcp/
*.swp
*.swo
.DS_Store

# Logs
*.log
logs/

# Local data / fixtures
data/
tmp/
*.sqlite
*.db
*.dump

# Local debug artifacts (screenshots, captures)
index-keywords.png
/*.png
/*.jpeg
/*.jpg

# Local agent scratch / tooling
.agents/
skills-lock.json

# Local build logs and tool profile backups (not repo content)
/work/

# Stray bundled JS chunks dropped into the repo root by the Codex desktop app
# (e.g. settings-page-<hash>.js). The web frontend lives under web/, so the
# repo root never holds source JS — safe to ignore wholesale.
/*.js
