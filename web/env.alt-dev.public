# Build-time public config for the ALT-account DEV frontend Worker
# (bowtie-content-tool-web-dev on the franco.ma@bowtie.com.hk Cloudflare account).
#
# Same dev Supabase project as env.dev.public — only the API base differs
# (the alt-account dev backend Worker). Deployed with:
#   CLOUDFLARE_API_TOKEN=$CF_ALT_API_TOKEN CLOUDFLARE_ACCOUNT_ID=$CF_ALT_ACCOUNT_ID \
#     node scripts/deploy-web.mjs alt-dev
#
# NON-SECRET ONLY — the dev Supabase anon key resolves from .env.dev.local
# (DEV_SUPABASE_ANON_KEY), same as the dev target.
NEXT_PUBLIC_API_BASE=https://bowtie-content-tool-poc-dev.franco-ma.workers.dev
NEXT_PUBLIC_SUPABASE_URL=https://ovxvhxwmqeccjudhyfbh.supabase.co
NEXT_PUBLIC_COLLAB_ENABLED=true
