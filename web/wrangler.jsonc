{
  // Cloudflare Worker for the Bowtie AI Content Tool frontend (Next.js 16 via
  // the OpenNext adapter). Built with `npm run cf:build`; deployed with
  // `npm run cf:deploy`. Free-plan, no Containers.
  //
  // Request model:
  //   - REST: the app calls relative `/api/*` paths; worker-entry.mjs proxies
  //     them to the backend Worker over the `API` service binding (Worker→Worker,
  //     never re-enters the public edge — so Cloudflare Access/WARP policies on
  //     the API hostname don't block the hop). Next `rewrites()` (next.config.mjs)
  //     remain as the local `next dev` fallback.
  //   - SSE:  the browser opens `${NEXT_PUBLIC_API_BASE}/runs/:id/events` and
  //     `/topic-batches/:id/events` DIRECTLY against the backend Worker, which
  //     now returns CORS headers (see deploy/cloudflare-workers/src/http/cors.ts).
  //
  // NEXT_PUBLIC_API_BASE is a build-time public var (inlined into the bundle),
  // so it is NOT set here — pass it when building, e.g.
  //   NEXT_PUBLIC_API_BASE=https://bowtie-content-tool.<acct>.workers.dev npm run cf:deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bowtie-content-tool-web",
  // Custom fast-path entry in front of OpenNext's handler — see worker-entry.mjs
  // for why (every route is prerendered; most requests never need the full
  // Next server). Falls through to .open-next/worker.js (dynamic import) for
  // anything it can't answer directly. Applies to every env below (inherited).
  "main": "worker-entry.mjs",
  "compatibility_date": "2026-05-30",
  "compatibility_flags": [
    // Node.js APIs used by the Next.js server runtime under OpenNext.
    "nodejs_compat",
    // Let `fetch()` reach public URLs rather than looping back internally.
    // The `/api/*` proxy now rides the `API` service binding, but this still
    // covers the no-binding fallback in worker-entry.mjs and any public
    // fetches from the OpenNext handler.
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true
  },
  // Backend Worker service binding — worker-entry.mjs dispatches the `/api/*`
  // proxy through this instead of a public fetch (see "Request model" above).
  // Non-inheritable: env.dev repeats it against the dev backend Worker.
  "services": [
    {
      "binding": "API",
      // The production backend Worker's ACTUAL deployed name (the Worker
      // serving api.content.seo.bowtie.hk) — service bindings resolve by
      // Worker name on the same account.
      "service": "ai-content-workflow-backend"
    }
  ],
  // Static assets (Next build output) served by the Worker.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // __prerender/* holds the materialized page shells served by
    // worker-entry.mjs via env.ASSETS.fetch — force those paths through the
    // Worker so direct GETs to /__prerender/*.html can't bypass the crawler
    // 403 / cookie gate (the entry 404s them; ASSETS.fetch still works).
    "run_worker_first": ["/__prerender/*"]
  },
  // Dev environment — parallel frontend Worker `bowtie-content-tool-web-dev`,
  // deployed with `npm run cf:deploy:dev`. `assets`, `main`, `compatibility_*`
  // and `observability` are inherited from the top level; only the Worker name
  // is overridden here. The NEXT_PUBLIC_* values (API base, Supabase URL/anon
  // key, collab + auth flags) are BUILD-TIME and passed as env vars at deploy
  // time (see docs/dev-environment-runbook.md), NOT set here.
  //
  // Both this Worker and its `dev` environment live on the same Cloudflare
  // account (Franco's "Bowtie Content SEO" account, franco-ma.workers.dev) —
  // the account previously used for prod (fmc.workers.dev) was deprecated by
  // Franco on 2026-07-07, so there is no `alt`/`alt-dev` split anymore.
  "env": {
    "dev": {
      "name": "bowtie-content-tool-web-dev",
      "workers_dev": true,
      "services": [
        {
          "binding": "API",
          "service": "bowtie-content-tool-poc-dev"
        }
      ]
    }
  }
}
