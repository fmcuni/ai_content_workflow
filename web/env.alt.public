# Build-time public config for the ALT frontend Worker (bowtie-content-tool-web
# on the separate franco.ma@bowtie.com.hk Cloudflare account).
#
# Compute-only duplicate of prod: same Supabase project (shared DB + auth) and
# same collab flag — only the API base differs (the alt backend Worker).
# Deployed with:
#   CLOUDFLARE_API_TOKEN=$CF_ALT_API_TOKEN CLOUDFLARE_ACCOUNT_ID=$CF_ALT_ACCOUNT_ID \
#     node scripts/deploy-web.mjs alt
#
# NON-SECRET ONLY — the Supabase anon key resolves from .env.local (same as prod).
NEXT_PUBLIC_API_BASE=https://bowtie-content-tool-poc.franco-ma.workers.dev
NEXT_PUBLIC_SUPABASE_URL=https://gfpkqsiyeslscgsuehmj.supabase.co
NEXT_PUBLIC_COLLAB_ENABLED=true
