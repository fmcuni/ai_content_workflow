# Build-time public config for the DEV frontend Worker (bowtie-content-tool-web-dev).
#
# SSOT for the dev NEXT_PUBLIC_* values. Sourced by scripts/deploy-web.mjs
# (used by `npm run cf:deploy:dev` AND the dev deploy CI workflow). This is the
# file that ENDS the recurring "bare cf:deploy:dev baked wrong NEXT_PUBLIC_* ->
# dev auth bounce" footgun: the values live here, parsed (never shell-sourced,
# which previously broke on DEV_POSTGRES_URL in .env.dev.local).
#
# NON-SECRET ONLY. The dev Supabase anon key is supplied at deploy time via the
# NEXT_PUBLIC_SUPABASE_ANON_KEY_DEV GH Actions secret (CI) or parsed from the
# gitignored .env.dev.local (local).
NEXT_PUBLIC_API_BASE=https://bowtie-content-tool-poc-dev.fmc.workers.dev
NEXT_PUBLIC_SUPABASE_URL=https://ovxvhxwmqeccjudhyfbh.supabase.co
# Dev mirrors prod (collab ON) so dev is a faithful pre-prod verification stack.
NEXT_PUBLIC_COLLAB_ENABLED=true
