# Build-time public config for the PROD frontend Worker (bowtie-content-tool-web).
#
# SSOT for the NEXT_PUBLIC_* values baked into the web bundle at build time.
# Sourced by scripts/deploy-web.mjs (used by `npm run cf:deploy` AND the
# Deploy Workers CI workflow) so prod build-time config has exactly ONE
# definition — no more hand-typed inline vars drifting between CI and local.
#
# NON-SECRET ONLY. The Supabase anon key is a public client key but is kept OUT
# of this file by policy (hygiene): it is supplied at deploy time via the
# NEXT_PUBLIC_SUPABASE_ANON_KEY GH Actions secret (CI) or from .env.local (local).
NEXT_PUBLIC_API_BASE=https://bowtie-content-tool-poc.fmc.workers.dev
NEXT_PUBLIC_SUPABASE_URL=https://gfpkqsiyeslscgsuehmj.supabase.co
# Realtime collab is a build-time flag; prod runs collab ON.
NEXT_PUBLIC_COLLAB_ENABLED=true
